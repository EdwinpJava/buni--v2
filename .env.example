# Variables para docker-compose.yml (copiar en Dokploy > Environment)
# Reemplaza buni.tu-dominio.com por tus dominios reales.

# ---------- Base de datos ----------
DB_ROOT_PASSWORD=cambia-esto-root
DB_NAME=buni
DB_USER=buni
DB_PASSWORD=cambia-esto-db

# ---------- API ----------
JWT_SECRET=genera-una-clave-larga-aleatoria
# Origenes permitidos (separados por coma, sin / final)
CORS_ORIGINS=https://buni.tu-dominio.com
# Usado en enlaces de correos
FRONTEND_URL=https://buni.tu-dominio.com

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=cambia-esto-admin
ADMIN_ROLE=Administrador

RATE_LIMIT_WINDOW_MINUTES=15
# Limite compartido por todos los usuarios (detras del proxy llegan con la misma IP)
RATE_LIMIT_MAX=10000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@gmail.com
SMTP_PASS=contrasena-de-aplicacion

# ---------- Frontend (se incrustan al compilar: redeploy si cambian) ----------
NEXT_PUBLIC_API_URL=https://api.buni.tu-dominio.com
NEXT_PUBLIC_WEBSOCKET_URL=wss://api.buni.tu-dominio.com
